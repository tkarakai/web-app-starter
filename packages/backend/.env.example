# Convex backend environment variables
# These are read by `bunx convex dev` from .env.local in this directory.
# For production, set via: bunx convex env set VAR_NAME "value"

# Better Auth allowed origins (comma-separated for multi-app development)
# In dev, this is auto-set by dev-start.sh to include all running app URLs
# In production, set this to the single app URL (or comma-separated list if multiple apps)
SITE_URL=http://localhost:3001

# Optional passkey RP ID override (hostname only, no scheme/path)
# Use this when web/admin run on sibling subdomains and should share passkeys.
# Example: PASSKEY_RP_ID=staging.example.com
PASSKEY_RP_ID=

# Better Auth secret (auto-generated by dev-start.sh)
BETTER_AUTH_SECRET=

# Admin privileges are managed via the `adminEmails` table in the Convex dashboard.
# Add rows with { email: "admin@example.com" } to grant admin role on sign-up.
# For existing users, also set role: "admin" on their record in the betterAuth user table.

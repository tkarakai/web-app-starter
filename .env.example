# Generated by `bunx convex dev`
#
# CONVEX_DEPLOYMENT
# - Convex deployment identifier used by the CLI and generated types.
# - Local: local:<name> (written by Convex when running `bunx convex dev`)
# - Cloud: dev:<adjective-animal-123> or prod:<...>
CONVEX_DEPLOYMENT=

# NEXT_PUBLIC_CONVEX_URL
# - Convex API endpoint used for queries/mutations.
# - Local: http://127.0.0.1:3210
# - Cloud: https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# NEXT_PUBLIC_CONVEX_SITE_URL
# - Convex site endpoint used by Better Auth's Convex proxy.
# - Local: http://127.0.0.1:3211
# - Cloud: https://<deployment>.convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# NEXT_PUBLIC_SITE_URL
# - Public URL of your Next.js app (used for auth redirects).
# - Local: http://localhost:3000
# - Cloud: https://app.example.com (your hosted Next.js app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set these in Convex (not in this file):
# bunx convex env set BETTER_AUTH_SECRET <value>
# bunx convex env set SITE_URL http://localhost:3000

{
  "name": "@repo/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "../../platform/tooling/next-dev.sh landing --turbopack",
    "prebuild": "../../platform/tooling/copy-shared-assets.sh",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "bun test qa/tests/*.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "size-limit",
    "size:check": "size-limit --json"
  },
  "dependencies": {
    "@web-app-starter/app-config": "workspace:*",
    "@web-app-starter/design-patterns": "workspace:*",
    "@web-app-starter/design-system": "workspace:*",
    "@web-app-starter/i18n": "workspace:*",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@repo/messages": "workspace:*",
    "@repo/onboarding": "workspace:*",
    "@web-app-starter/auth-ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}

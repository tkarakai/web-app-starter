# Public URL where the static site will be hosted. Left empty here: locally,
# ensure-app-env.sh fills it in from the landing-static port in app.config.ts.
NEXT_PUBLIC_SITE_URL=

# Web app URL (for cross-app links to sign-up, dashboard). Filled in locally from
# the web port in app.config.ts.
NEXT_PUBLIC_WEB_APP_URL=

# Environment banner (development | staging | production)
# Leave empty in production. Auto-detected as "development" when NODE_ENV=development.
# NEXT_PUBLIC_APP_ENVIRONMENT=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_DEPLOY_TIMESTAMP=
# NEXT_PUBLIC_APP_NAME=landing-static
# NEXT_PUBLIC_BUILD_ID=

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["EDGE_RATE_LIMIT_WINDOW", "EDGE_RATE_LIMIT_MAX", "EDGE_RATE_LIMIT_MAP_MAX_SIZE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["EDGE_RATE_LIMIT_WINDOW", "EDGE_RATE_LIMIT_MAX", "EDGE_RATE_LIMIT_MAP_MAX_SIZE"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:convex": {},
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["qa/coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}

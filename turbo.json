{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      "env": [
        "EDGE_RATE_LIMIT_WINDOW",
        "EDGE_RATE_LIMIT_MAX",
        "EDGE_RATE_LIMIT_MAP_MAX_SIZE",
        "CONVEX_URL",
        "CONVEX_SITE_URL",
        "APP_ORIGIN",
        "LANDING_URL",
        "WEB_APP_URL",
        "APP_ENVIRONMENT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "EDGE_RATE_LIMIT_WINDOW",
        "EDGE_RATE_LIMIT_MAX",
        "EDGE_RATE_LIMIT_MAP_MAX_SIZE",
        "CONVEX_URL",
        "CONVEX_SITE_URL",
        "APP_ORIGIN",
        "LANDING_URL",
        "WEB_APP_URL",
        "APP_ENVIRONMENT"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CONVEX_URL", "CONVEX_SITE_URL", "APP_ORIGIN", "LANDING_URL", "APP_ENVIRONMENT"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "env": ["CONVEX_URL", "CONVEX_SITE_URL", "APP_ORIGIN", "LANDING_URL", "APP_ENVIRONMENT"]
    },
    "test:convex": {},
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["qa/coverage/**"],
      "env": ["CONVEX_URL", "CONVEX_SITE_URL", "APP_ORIGIN", "LANDING_URL", "APP_ENVIRONMENT"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["CONVEX_URL", "CONVEX_SITE_URL", "APP_ORIGIN", "LANDING_URL", "APP_ENVIRONMENT"]
    }
  }
}

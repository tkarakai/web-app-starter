{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "codemods/*.ts",
    "e2e/*.ts",
    "tests/*.ts",
    "platform-upgrade/*.ts",
    "update-check.ts",
    "setup-updates/*.ts",
    "deploy-setup/*.ts",
    "ci-workers/*.ts"
  ]
}

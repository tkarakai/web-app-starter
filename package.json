{
  "name": "web-app-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run --cwd packages/starter-sidebar-policy build",
    "predev": "./scripts/ensure-local-deps.sh --quiet && ./scripts/ensure-app-env.sh --quiet && ./scripts/copy-shared-assets.sh",
    "dev": "./scripts/dev-start.sh",
    "dev:ci": "./scripts/dev-start.sh --ci",
    "dev:web": "./scripts/dev-start.sh --app=web",
    "dev:admin": "./scripts/dev-start.sh --app=admin",
    "dev:landing": "./scripts/dev-start.sh --app=landing",
    "dev:storybook": "./scripts/dev-start.sh --app=storybook",
    "dev:landing-static": "turbo dev --filter=@repo/landing-static",
    "ensure-local": "./scripts/ensure-local-deps.sh",
    "dev:stop": "./scripts/dev-stop.sh",
    "dev:stop:convex": "./scripts/dev-stop-convex.sh",
    "dev:nuke-db": "./scripts/dev-nuke-db.sh",
    "dev:nuke-all": "./scripts/dev-nuke-all.sh",
    "dev:status": "./scripts/dev-status.sh",
    "copy-assets": "./scripts/copy-shared-assets.sh",
    "prebuild": "./scripts/ensure-app-env.sh --quiet && ./scripts/copy-shared-assets.sh",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:convex": "turbo test:convex",
    "pretest:e2e": "./scripts/ensure-app-env.sh --quiet",
    "test:e2e": "turbo test:e2e",
    "test:all": "turbo test test:unit test:convex test:e2e",
    "clean": "rm -rf apps/*/.next apps/*/.turbo packages/*/.turbo .turbo",
    "ci": "./scripts/ci-local.sh",
    "ci:quick": "./scripts/ci-local.sh --skip-e2e",
    "ci:reset-coverage": "./scripts/ci-local.sh --reset-coverage",
    "ci:act": "./scripts/ci-local-act.sh",
    "ci:act:quick": "./scripts/ci-local-act.sh -q",
    "ci:act:offline": "./scripts/ci-local-act.sh -o",
    "infra:setup:staging": "./scripts/infra-setup-staging.sh",
    "aws:local:up": "./infra/aws/local/local-up.sh",
    "aws:local:down": "./infra/aws/local/local-down.sh",
    "aws:validate": "./infra/aws/scripts/validate.sh",
    "ensure-env": "./scripts/ensure-app-env.sh",
    "test:dev-scripts": "./scripts/node-ts.sh --test scripts/tests/*.test.ts",
    "typecheck:dev-scripts": "tsc -p scripts/tsconfig.json",
    "check:runtime-baseline": "./scripts/node-ts.sh scripts/check-runtime-baseline.ts",
    "renovate:status": "./scripts/node-ts.sh scripts/renovate-status.ts",
    "lint:dev-scripts": "eslint scripts/check-runtime-baseline.ts scripts/renovate-status.ts scripts/dev-processes.ts scripts/resolve-i18n-conflicts.ts scripts/staging-log.ts scripts/tests --max-warnings 0",
    "test:starter-upgrade": "./scripts/node-ts.sh --test scripts/starter-upgrade/*.test.ts",
    "test:starter-rehearsal": "./scripts/node-ts.sh scripts/starter-upgrade/rehearse.ts",
    "starter-upgrade": "./scripts/node-ts.sh scripts/starter-upgrade/upgrade.ts",
    "check:starter-ownership": "./scripts/node-ts.sh scripts/starter-upgrade/check-ownership.ts",
    "typecheck:starter-upgrade": "tsc -p scripts/starter-upgrade/tsconfig.json",
    "lint:starter-upgrade": "eslint scripts/starter-upgrade --max-warnings 0",
    "ops": "bun packages/ops/src/cli.ts",
    "test:ops": "bun test packages/ops/tests packages/paper-roll/tests",
    "typecheck:ops": "bun run --cwd packages/ops typecheck"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "convex": "1.45.0",
    "next": "16.3.5",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.5.0",
    "typescript": "6.0.3"
  }
}

{
  "name": "web-app-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "platform/apps/*",
    "platform/packages/*"
  ],
  "scripts": {
    "postinstall": "bun run --cwd platform/packages/starter-sidebar-policy build",
    "predev": "./platform/tooling/ensure-local-deps.sh --quiet && ./platform/tooling/ensure-app-env.sh --quiet && ./platform/tooling/copy-shared-assets.sh",
    "dev": "./platform/tooling/dev-start.sh",
    "dev:ci": "./platform/tooling/dev-start.sh --ci",
    "dev:web": "./platform/tooling/dev-start.sh --app=web",
    "dev:admin": "./platform/tooling/dev-start.sh --app=admin",
    "dev:landing": "./platform/tooling/dev-start.sh --app=landing",
    "dev:storybook": "./platform/tooling/dev-start.sh --app=storybook",
    "dev:landing-static": "turbo dev --filter=@repo/landing-static",
    "ensure-local": "./platform/tooling/ensure-local-deps.sh",
    "dev:stop": "./platform/tooling/dev-stop.sh",
    "dev:stop:convex": "./platform/tooling/dev-stop-convex.sh",
    "dev:nuke-db": "./platform/tooling/dev-nuke-db.sh",
    "dev:nuke-all": "./platform/tooling/dev-nuke-all.sh",
    "dev:status": "./platform/tooling/dev-status.sh",
    "copy-assets": "./platform/tooling/copy-shared-assets.sh",
    "prebuild": "./platform/tooling/ensure-app-env.sh --quiet && ./platform/tooling/copy-shared-assets.sh",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:convex": "turbo test:convex",
    "setup:e2e": "./platform/tooling/setup-e2e.sh",
    "pretest:e2e": "./platform/tooling/ensure-app-env.sh --quiet",
    "test:e2e": "turbo test:e2e",
    "test:all": "turbo test test:unit test:convex test:e2e",
    "clean": "rm -rf apps/*/.next apps/*/.turbo packages/*/.turbo platform/apps/*/.next platform/apps/*/.turbo platform/packages/*/.turbo .turbo",
    "ci": "./platform/tooling/ci-local.sh",
    "ci:quick": "./platform/tooling/ci-local.sh --skip-e2e",
    "ci:reset-coverage": "./platform/tooling/ci-local.sh --reset-coverage",
    "ci:act": "./platform/tooling/ci-local-act.sh",
    "ci:act:quick": "./platform/tooling/ci-local-act.sh -q",
    "ci:act:offline": "./platform/tooling/ci-local-act.sh -o",
    "infra:setup:staging": "./platform/tooling/infra-setup-staging.sh",
    "aws:local:up": "./infra/aws/local/local-up.sh",
    "aws:local:down": "./infra/aws/local/local-down.sh",
    "aws:local:status": "./infra/aws/local/local-status.sh",
    "aws:local:check": "./infra/aws/scripts/smoke-check.sh --env local",
    "aws:local:logs": "tail -n 50 -f infra/aws/local/.state/convex.log",
    "aws:validate": "./infra/aws/scripts/validate.sh",
    "ensure-env": "./platform/tooling/ensure-app-env.sh",
    "test:dev-scripts": "./platform/tooling/node-ts.sh --test platform/tooling/tests/*.test.ts",
    "typecheck:dev-scripts": "tsc -p platform/tooling/tsconfig.json",
    "check:runtime-baseline": "./platform/tooling/node-ts.sh platform/tooling/check-runtime-baseline.ts",
    "check:agent-skills": "./platform/tooling/node-ts.sh platform/tooling/check-agent-skills.ts",
    "check:i18n": "./platform/tooling/node-ts.sh platform/tooling/check-i18n.ts",
    "renovate:status": "./platform/tooling/node-ts.sh platform/tooling/renovate-status.ts",
    "lint:dev-scripts": "eslint platform/tooling/app-config.ts platform/tooling/check-runtime-baseline.ts platform/tooling/check-agent-skills.ts platform/tooling/check-i18n.ts platform/tooling/renovate-status.ts platform/tooling/dev-processes.ts platform/tooling/resolve-i18n-conflicts.ts platform/tooling/staging-log.ts platform/tooling/codemods platform/tooling/tests --max-warnings 0",
    "test:starter-upgrade": "./platform/tooling/node-ts.sh --test platform/tooling/starter-upgrade/*.test.ts",
    "test:starter-rehearsal": "./platform/tooling/node-ts.sh platform/tooling/starter-upgrade/rehearse.ts",
    "starter-upgrade": "./platform/tooling/node-ts.sh platform/tooling/starter-upgrade/upgrade.ts",
    "check:starter-ownership": "./platform/tooling/node-ts.sh platform/tooling/starter-upgrade/check-ownership.ts",
    "typecheck:starter-upgrade": "tsc -p platform/tooling/starter-upgrade/tsconfig.json",
    "lint:starter-upgrade": "eslint platform/tooling/starter-upgrade --max-warnings 0",
    "ops": "bun platform/packages/ops/src/cli.ts",
    "test:ops": "bun test platform/packages/ops/tests platform/packages/paper-roll/tests",
    "typecheck:ops": "bun run --cwd platform/packages/ops typecheck"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "convex": "1.45.0",
    "next": "16.3.5",
    "typescript-eslint": "8.70.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.5.0",
    "typescript": "6.0.3"
  }
}

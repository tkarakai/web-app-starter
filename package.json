{
  "name": "web-app-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.43",
  "scripts": {
    "predev": "./scripts/ensure-local-deps.sh --quiet",
    "dev": "./scripts/dev-start.sh",
    "ensure-local": "./scripts/ensure-local-deps.sh",
    "dev:stop": "./scripts/dev-stop.sh",
    "dev:status": "./scripts/dev-status.sh",
    "dev:next": "next dev",
    "dev:convex": "bunx convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test tests/*.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:vitest": "vitest",
    "test:playwright": "playwright test",
    "test:convex": "vitest run --config vitest.config.convex.ts",
    "test:all": "bun test tests/*.test.ts && vitest run && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.10.10",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "better-auth": "1.4.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.31.6",
    "lucide-react": "0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.0.8",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "10.4.23",
    "convex-test": "^0.0.41",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.1",
    "happy-dom": "^20.3.7",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  }
}

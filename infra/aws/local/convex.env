# Convex environment variables of the local target's Convex deployment, set by
# deploy-convex.sh --env local. On staging/production these live on the Convex
# Cloud deployment and are managed there (platform/docs/aws/deployment-runbook-aws.md).
# SITE_URL, ADMIN_SITE_URL and LANDING_URL come from the stack outputs, and a
# BETTER_AUTH_SECRET is generated on first deploy.

# web.app.localhost and admin.app.localhost share passkeys under their parent,
# as web.<domain> and admin.<domain> do with PASSKEY_RP_ID=<domain> on AWS.
PASSKEY_RP_ID=app.localhost

# Enables the E2E fixture endpoint (/api/dev/e2e-user), so the Playwright suite
# can run against this target. Never set on staging or production.
DEV_SEED_ENABLED=true
